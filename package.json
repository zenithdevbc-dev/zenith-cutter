{
  "name": "zenith-cutter",
  "productName": "Zenith Cutter",
  "version": "1.0.2",
  "description": "Gerenciamento do setor de corte de confecções",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "release:publish": "node scripts/publish-release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenithdevbc-dev/zenith-cutter.git"
  },
  "keywords": [],
  "author": "Zenith DEV",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/zenithdevbc-dev/zenith-cutter/issues"
  },
  "homepage": "https://github.com/zenithdevbc-dev/zenith-cutter#readme",
  "build": {
    "appId": "dev.zenithdev.zenithcutter",
    "productName": "Zenith Cutter",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Zenith-Cutter-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://ymslhcxdoiofqswwlcpn.supabase.co/storage/v1/object/public/releases"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.16",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/vite": "^4.3.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  }
}
