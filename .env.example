# Copie este arquivo para ".env" e preencha com as credenciais do projeto
# Supabase (Settings > API no painel do projeto). O arquivo ".env" nunca
# deve ser commitado (já está no .gitignore).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auto-update (electron-updater): quando o bucket de releases no
# Supabase Storage existir, adicione ao "build.publish" do package.json:
#   "publish": { "provider": "generic", "url": "<URL_PUBLICA_DO_BUCKET>" }
# Sem isso, o app roda normalmente e apenas ignora a checagem de
# atualização (offline first — nunca deve travar por causa disso).
