# Copie este arquivo para ".env" e preencha com as credenciais do projeto
# Supabase (Settings > API no painel do projeto). O arquivo ".env" nunca
# deve ser commitado (já está no .gitignore).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auto-update (electron-updater): bucket público "releases" já criado
# no Supabase Storage, já configurado em "build.publish" do
# package.json. Sem internet, o app roda normalmente e apenas ignora a
# checagem de atualização (offline first — nunca deve travar por
# causa disso).
#
# Só necessária pra "npm run release:publish" (sobe os artefatos de
# build pro bucket) — nunca é lida pelo app em si: sem prefixo VITE_,
# não entra no bundle do renderer. Pegue em Settings > API >
# service_role no painel do Supabase. NUNCA comitar o valor real (o
# ".env" já está no .gitignore) nem colar em conversas — é uma chave
# que ignora todo RLS do projeto.
SUPABASE_SERVICE_ROLE_KEY=
