# Dependencies
node_modules/

# Build output
dist/
dist-electron/
dist-native/
release/
out/
# Nota: build/ NÃO é ignorado — é a pasta de recursos de build do
# electron-builder (ícones etc.), deve ser versionada.

# Environment / secrets
.env
.env.*
!.env.example

# Local database
*.sqlite
*.sqlite3
*.db

# Logs
*.log
npm-debug.log*
logs/

# OS
Thumbs.db
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code local settings
.claude/settings.local.json

# Supabase CLI local cache (link state, não é segredo, mas é local da máquina)
supabase/.temp/

# Electron / packaging
*.exe
*.msi
*.dmg
*.AppImage
